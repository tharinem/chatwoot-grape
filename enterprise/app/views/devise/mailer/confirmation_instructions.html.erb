<p>Olá, <%= @resource.name %>!</p>

<% account_user = @resource&.account_users&.first %>
<% is_saml_account = account_user&.account&.saml_enabled? %>

<% if account_user&.inviter.present? && @resource.unconfirmed_email.blank? %>
  <% if is_saml_account %>
    <p><%= account_user.inviter.name %>, da <%= account_user.account.name %>, convidou você para acessar a <%= global_config['BRAND_NAME'] || 'Chatwoot' %> com login único (SSO).</p>
    <p>A sua empresa usa SSO para entrar com segurança. Você não precisa de senha para acessar a sua conta.</p>
  <% else %>
    <p><%= account_user.inviter.name %>, da <%= account_user.account.name %>, convidou você para usar a <%= global_config['BRAND_NAME'] || 'Chatwoot' %>.</p>
  <% end %>
<% end %>

<% if @resource.confirmed? %>
  <p>Você já pode entrar na sua conta da <%= global_config['BRAND_NAME'] || 'Chatwoot' %> pelo link abaixo:</p>
<% else %>
  <% if account_user&.inviter.blank? %>
  <p>Boas-vindas à <%= global_config['BRAND_NAME'] || 'Chatwoot' %>! Antes de começar, precisamos confirmar o seu e-mail.</p>
  <% end %>
  <% unless is_saml_account %>
  <p>Clique no link abaixo para ativar a sua conta.</p>
  <% end %>
<% end %>


<% if @resource.unconfirmed_email.present? %>
  <p><%= link_to 'Confirmar meu e-mail', frontend_url('auth/confirmation', confirmation_token: @token) %></p>
<% elsif @resource.confirmed? %>
  <% if is_saml_account %>
    <p>Você já pode entrar na sua conta pelo portal de SSO da sua empresa.</p>
  <% else %>
    <p><%= link_to 'Entrar na minha conta', frontend_url('auth/sign_in') %></p>
  <% end %>
<% elsif account_user&.inviter.present? %>
  <% if is_saml_account %>
    <p>Você pode entrar na sua conta pelo portal de SSO da sua empresa.</p>
  <% else %>
    <p><%= link_to 'Criar minha senha', frontend_url('auth/password/edit', reset_password_token: @resource.send(:set_reset_password_token)) %></p>
  <% end %>
<% else %>
  <p><%= link_to 'Confirmar minha conta', frontend_url('auth/confirmation', confirmation_token: @token) %></p>
<% end %>
